# Variables de entorno para Teorema-Rival (Configuración OpenAI)
# Copia este archivo como .env y rellena los valores para desarrollo local

# Clave de API de OpenAI (Obligatoria para TTS y Whisper)
OPENAI_API_KEY=sk-your-openai-key-here

# URL del servidor de Texto-a-Voz (OpenAI TTS)
TTS_API_URL=https://api.openai.com/v1/audio/speech

# URL del servidor de Transcripción (OpenAI Whisper)
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
