# Variables de entorno para Teorema-Rival
# Copia este archivo como .env y rellena los valores para desarrollo local

# URL del servidor de Texto-a-Voz (TTS/RVC)
TTS_API_URL=http://localhost:8000

# URL del servidor de Transcripción (Open Whisper)
WHISPER_API_URL=http://localhost:8001/transcribe

# Clave de API para Whisper (si aplica)
WHISPER_API_KEY=tu_api_key_aqui
